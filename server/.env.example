# Copy to .env. Never put these credentials in EXPO_PUBLIC variables.
OPENAI_API_KEY=
# Set to an image-edit model enabled for your account; confirm with npm run smoke.
IMAGE_MODEL=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Enter this restricted demo-session token on the phone at runtime; do not commit it.
DEMO_SESSION_TOKEN=
PORT=3001
HOST=0.0.0.0
# Optional browser tooling only. Native Expo requests do not require CORS.
ALLOWED_ORIGIN=

# Product search: separate from OpenAI image generation credentials.
# Amazon Creators API approval + marketplace partner tag required.
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_PARTNER_TAG=
AMAZON_MARKETPLACE=www.amazon.com
AMAZON_CREDENTIAL_VERSION=3.1
# eBay production Browse API credentials (US marketplace in this version).
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Optional absolute path to a permitted IKEA product feed in the documented JSON shape.
IKEA_CATALOG_PATH=
# Coupang Partners Open API (Korea). Approved Partners account required. The connector is NOT active yet:
# with keys set it still sends no request until the official API contract is verified (see src/discovery/README.md).
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
